# ============================================================
# App
# ============================================================
BETTER_AUTH_SECRET=change-this-to-a-random-32-char-string
BETTER_AUTH_URL=https://yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ============================================================
# Database (local — used by the app container)
# ============================================================
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=trivia
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=trivia_db

# ============================================================
# Traefik
# ============================================================
DOMAIN=yourdomain.com
TRAEFIK_NETWORK=traefik_proxy

# ============================================================
# Search (optional — can be added from Settings after deploy)
# ============================================================
TAVILY_API_KEY=tvly-...

# ============================================================
# Production DB export (optional)
# ============================================================
PRODUCTION_DB_URL=postgresql://user:password@prod-host:5432/prod_db
